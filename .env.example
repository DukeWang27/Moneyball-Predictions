# Local fallback; replace with Neon's pooled connection string in production.
DATABASE_URL=sqlite+pysqlite:///data/moneyball_app.sqlite3
# Neon's direct connection string is used only by Alembic migrations.
DATABASE_URL_DIRECT=

# Browser-native Basic Auth. Leave blank only for local development.
DASHBOARD_USERNAME=moneyball
DASHBOARD_PASSWORD=

# External scheduler authorization for the two cron endpoints.
CRON_SECRET=

# Existing market integrations.
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
MONEYBALL_CODE_COMMIT=local
